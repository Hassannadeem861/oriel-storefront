# Public URL of the site, used for canonical URLs, sitemap and Open Graph.
# Production builds default to https://oriel-storefront.vercel.app when unset;
# set this for a custom domain. Use http://localhost:3000 for local testing.
NEXT_PUBLIC_SITE_URL=https://oriel-storefront.vercel.app

# Leave empty to run on seeded demo data with the simulated API (demo mode).
# Set to your backend's base URL to send all store API calls there instead.
NEXT_PUBLIC_API_URL=
